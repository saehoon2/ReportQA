# ==========================================
# ReportQA 환경설정 견본
# ------------------------------------------
# 사용법: 이 파일을 복사해 .env 를 만들고 값을 채웁니다.
#   cp .env.example .env
# .env 는 GitHub에 올라가지 않습니다 (.gitignore 등록).
# 항목별 자세한 설명: docs/env_spec.md
# 규칙: 이름=값 (= 양옆에 띄어쓰기 없음)
# ==========================================

# ---------- OpenAI (1주차) ----------
# [비밀] OpenAI API 키. 실제 값은 .env 에만 적습니다.
OPENAI_API_KEY=
# 답변 생성 모델 (1주차에 최신 모델·가격 확인 후 기입)
LLM_MODEL=
# 차트·표 이미지 캡션 모델 (이미지 입력 지원 모델)
VISION_MODEL=
# 임베딩 모델 (글 -> 벡터)
EMBEDDING_MODEL=
# 채점 모델 (3주차, 답변 모델보다 한 단계 강한 모델 권장)
JUDGE_MODEL=

# ---------- 경로 (2주차) ----------
DATA_DIR=./data

# ---------- 문서 처리 (2주차, 평가 결과를 보고 조정) ----------
# 청크 하나의 최대 글자 수
CHUNK_SIZE=800
# 앞뒤 청크가 겹치는 글자 수
CHUNK_OVERLAP=100
# 문서 1개를 처리할 때 새로 만들 차트 캡션의 최대 개수 (Vision 비용 상한)
MAX_CAPTION_PAGES=60

# ---------- 데이터베이스 (5주차) ----------
# 아래는 내 컴퓨터(Docker) 안에서만 쓰는 개발용 기본값입니다.
# 외부에 공개하는 서버라면 반드시 다른 비밀번호로 바꾸세요.
POSTGRES_USER=reportqa
POSTGRES_PASSWORD=reportqa
POSTGRES_DB=reportqa
# 내 PC에서 서버 실행: localhost / Docker Compose 안에서 실행: db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------- 검색 (6주차) ----------
# 1차 검색(벡터 + BM25)에서 가져올 후보 수
RETRIEVE_TOP_K=20
# 리랭킹 후 답변에 쓸 근거 수
RERANK_TOP_K=5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 리랭커를 끄려면 false (모델 약 2GB를 내려받지 않고 하이브리드 검색만 사용)
USE_RERANKER=true
# 리랭커 1등 점수가 이보다 낮으면 LLM을 부르지 않고 "찾을 수 없음" (6주차 평가로 결정)
RELEVANCE_THRESHOLD=0.0

# ---------- 화면 (7주차) ----------
# 내 PC: http://localhost:8000 / Docker Compose 안: http://api:8000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
