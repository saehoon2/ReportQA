# ==========================================
# ReportQA 환경설정 견본
# ------------------------------------------
# 사용법: 이 파일을 복사해 .env 를 만들고 값을 채웁니다.
#   cp .env.example .env
# .env 는 GitHub에 올라가지 않습니다 (.gitignore 등록).
# 항목별 자세한 설명: docs/env_spec.md
# 규칙: 이름=값 (= 양옆에 띄어쓰기 없음)
# ==========================================

# ---------- OpenAI (1주차) ----------
# [비밀] OpenAI API 키. 실제 값은 .env 에만 적습니다.
OPENAI_API_KEY=
# 답변 생성 모델 (1주차에 최신 모델·가격 확인 후 기입)
LLM_MODEL=
# 차트·표 이미지 캡션 모델 (이미지 입력 지원 모델)
VISION_MODEL=
# 임베딩 모델 (글 -> 벡터)
EMBEDDING_MODEL=

# ---------- 경로 (2주차) ----------
DATA_DIR=./data

# ---------- 문서 처리 (2주차, 평가 결과를 보고 조정) ----------
# 청크 하나의 최대 글자 수
CHUNK_SIZE=800
# 앞뒤 청크가 겹치는 글자 수
CHUNK_OVERLAP=100
